# Copy to .env and fill in. NEVER commit .env
DATABASE_URL=postgresql+psycopg2://jobhunt:change_me@localhost:5432/jobhunt
AI_PROVIDER=ollama
AI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
JWT_SECRET=change_this_to_a_long_random_string
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=../uploads
LOG_LEVEL=INFO

# ---- Optional free job sources (leave empty to skip) ----
# https://developer.adzuna.com (free key; covers GB, US, IN, SG, AU... NOT Sri Lanka)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
# https://jooble.org/api/about (free key; test Sri Lanka coverage yourself)
JOOBLE_API_KEY=
# Arbeitnow (Germany) allows personal, non-commercial use only. Enable only for personal use.
ENABLE_ARBEITNOW=false
# https://www.careerjet.com/partners/ (free publisher key; aggregates many job sites)
CAREERJET_API_KEY=
CAREERJET_USER_IP=
